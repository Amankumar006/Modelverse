  "description": "Agentic system that reconstructs editable design structure from a flat raster image by iteratively decomposing it into editable layers.",
  "architecture": {
    "type": "Agentic VLM pipeline",
    "controller": "OpenAI-compatible VLM",
    "representation": "Tree of editable layers",
    "search": "Breadth-first decomposition",
    "verification": "Modular verifier"
  },
  "workflow": [
    "Start with full image as root node",
    "Controller selects next decomposition tool",
    "Verifier validates split",
    "Repeat until editable leaf nodes",
    "Export editable JSON hierarchy"
  ],
  "tools": [
    {
      "action": "Extract text",
      "components": [
        "PaddleOCR",
        "Font Recognition",
        "Hi-SAM",
        "LaMa"
      ],
      "output": "Editable text layer"
    },
    {
      "action": "Fork layers",
      "components": [
        "Qwen-Image-Layered"
      ],
      "output": "RGBA layers"
    },
    {
      "action": "Split",
      "components": [
        "Connected Component Analysis"
      ],
      "output": "Separated regions"
    },
    {
      "action": "Detect & segment",
      "components": [
        "GroundingDINO",
        "SAM2",
        "Inpainting"
      ],
      "output": "Foreground/background"
    },
    {
      "action": "Vectorize",
      "components": [
        "VTracer"
      ],
      "output": "SVG-like vector paths"
    }
  ],
