  "byteCounts": 36117,
  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta http-equiv=\"Cache-Control\" content=\"no-cache, no-store, must-revalidate\">\n    <meta http-equiv=\"Pragma\" content=\"no-cache\">\n    <meta http-equiv=\"Expires\" content=\"0\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>WavFlow — Audio Generation in Waveform Space</title>\n    <meta name=\"description\" content=\"WavFlow generates high-fidelity audio directly in raw waveform space using waveform patchifying, amplitude lifting, and stable flow matching.\">\n\n    <link rel=\"icon\" type=\"image/png\" href=\"images/icon.png\">\n\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.0.1/dist/css/bootstrap.min.css\" rel=\"stylesheet\"\n        integrity=\"sha384-+0n0xVW2eSR5OomGNYDnhzAbDsOXxcvSN1TPprVMTNDbiYZCxYbOOl7+AMvyTG2x\" crossorigin=\"anonymous\">\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n    <!-- ============== Top nav ============== -->\n    <nav class=\"topnav\">\n        <div class=\"topnav__inner\">\n            <a class=\"topnav__brand\" href=\"#top\">\n                <span class=\"topnav__dot\"></span>\n                <span>WavFlow</span>\n            </a>\n            <div class=\"topnav__links\">\n                <a href=\"#overview\">Overview</a>\n                <a href=\"#method\">Method</a>\n                <a href=\"#demos\">Demos</a>\n                <a href=\"#benchmark\">Comparison</a>\n                <a href=\"#results\">Results</a>\n                <a href=\"#bibtex\">BibTeX</a>\n            </div>\n        </div>\n    </nav>\n\n    <!-- ============== HERO ============== -->\n    <header id=\"top\" class=\"hero\">\n        <div class=\"hero__inner\">\n            <h1 class=\"hero__title\">\n                <span class=\"grad\">WavFlow</span>: Audio Generation in <br>\n                Waveform Space\n            </h1>\n            <p class=\"hero__tagline\">\n                High-fidelity audio synthesized directly in raw waveform space — no VAE, no latent compression.\n            </p>\n\n            <!-- Authors -->\n            <div class=\"authors\">\n                <span class=\"author\"><a href=\"https://zhoufeiyn.github.io/\" target=\"_blank\" rel=\"noopener\">Feiyan Zhou<sup>1,2</sup></a></span>\n                <span class=\"author\"><a href=\"https://www.luyuan.wang/\" target=\"_blank\" rel=\"noopener\">Luyuan Wang<sup>1</sup></a></span>\n                <span class=\"author\"><a href=\"https://www.shoufachen.com/\" target=\"_blank\" rel=\"noopener\">Shoufa Chen<sup>1,&#42;</sup></a></span>\n                <span class=\"author\"><a href=\"https://wangzheallen.github.io/\" target=\"_blank\" rel=\"noopener\">Zhe Wang<sup>1</sup></a></span>\n                <span class=\"author\"><a href=\"https://johanan528.github.io/\" target=\"_blank\" rel=\"noopener\">Zhiheng Liu<sup>1</sup></a></span>\n                <span class=\"author\"><a href=\"https://yrcong.github.io/\" target=\"_blank\" rel=\"noopener\">Yuren Cong<sup>1</sup></a></span>\n                <span class=\"author\"><a href=\"https://www.linkedin.com/in/xiaohui-zhang-79569539\" target=\"_blank\" rel=\"noopener\">Xiaohui Zhang<sup>1</sup></a></span>\n                <span class=\"author\"><a href=\"https://www.linkedin.com/in/fanny-yang-035861128\" target=\"_blank\" rel=\"noopener\">Fanny Yang<sup>1</sup></a></span>\n                <span class=\"author\"><a href=\"https://www.linkedin.com/in/belindazeng\" target=\"_blank\" rel=\"noopener\">Belinda Zeng<sup>1</sup></a></span>\n            </div>\n\n            <!-- Affiliations -->\n            <div class=\"affiliations\">\n                <span class=\"affiliation\">\n                    <sup>1</sup> Meta AI\n                    <img src=\"images/meta.png\" alt=\"Meta\" class=\"affiliation-logo\">\n                </span>\n                <span class=\"affiliation\">\n                    <sup>2</sup> Northeastern University\n                    <img src=\"images/northeastern.png\" alt=\"Northeastern University\" class=\"affiliation-logo affiliation-logo--lg\">\n                </span>\n            </div>\n\n            <p class=\"corresponding-author\"><sup>&#42;</sup>Corresponding author</p>\n\n            <!-- CTAs -->\n            <div class=\"link-btns\">\n                <a href=\"https://arxiv.org/abs/2605.18749\" class=\"btn btn-primary\" target=\"_blank\" rel=\"noopener\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/></svg>\n                    Read the Paper\n                </a>\n                <a href=\"https://github.com/facebookresearch/wavflow\" class=\"btn btn-dark\" target=\"_blank\" rel=\"noopener\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.01-.02-1.99-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18.92-.26 1.9-.39 2.88-.39.98 0 1.96.13 2.88.39 2.2-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18 0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z\"/></svg>\n                    GitHub\n                </a>\n                <a href=\"#demos\" class=\"btn btn-ghost\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"5 3 19 12 5 21 5 3\"/></svg>\n                    Watch Demos\n                </a>\n            </div>\n        </div>\n        <div class=\"hero__wave\" aria-hidden=\"true\"></div>\n    </header>\n\n    <!-- ============== OVERVIEW ============== -->\n    <section id=\"overview\">\n        <div class=\"container\">\n            <div class=\"section-head\">\n                <span class=\"section-eyebrow\">Overview</span>\n                <h2 class=\"section-title\">Generation in Raw Waveform Space</h2>\n                <p class=\"section-subtitle\">\n                    A simpler, more scalable alternative to latent-space audio generation.\n                </p>\n            </div>\n\n            <div class=\"abstract-card\">\n                <p>\n                    Modern audio generation predominantly relies on latent-space compression,\n                    which introduces complexity and potential information loss.\n                    <span class=\"metablue strong\">WavFlow</span> challenges this paradigm by\n                    generating high-fidelity audio directly in <b>raw waveform space</b>. By\n                    utilizing <b>waveform patchifying</b> and <b>amplitude lifting</b>,\n                    WavFlow enables stable flow matching via direct <i>x</i>-prediction,\n                    bypassing intermediate representations entirely. Achieving\n                    highly competitive results across multiple benchmarks,\n                    WavFlow demonstrates that latent compression is not a prerequisite for\n                    high-quality synthesis, offering a simpler and more scalable alternative\n                    for multimodal generation.\n                </p>\n            </div>\n\n            <div class=\"overview-figure-wrap\">\n                <img src=\"images/overview.png\" alt=\"WavFlow overview\" class=\"overview-figure\">\n            </div>\n        </div>\n    </section>\n\n    <!-- ============== METHOD ============== -->\n    <section id=\"method\">\n        <div class=\"container\">\n            <div class=\"section-head\">\n                <span class=\"section-eyebrow\">Method</span>\n                <h2 class=\"section-title\">Architecture</h2>\n                <p class=\"section-subtitle\">\n                    Waveform patchifying + amplitude lifting enable stable flow matching\n                    with direct <i>x</i>-prediction in waveform space.\n                </p>\n            </div>\n\n            <div class=\"method-figure-wrap\">\n                <img src=\"images/Architecture.png\" alt=\"WavFlow architecture\">\n            </div>\n        </div>\n    </section>\n\n    <!-- ============== DEMOS ============== -->\n    <section id=\"demos\">\n        <div class=\"container\">\n            <div class=\"section-head\">\n                <span class=\"section-eyebrow\">Demos</span>\n                <h2 class=\"section-title\">Hear It Raw</h2>\n                <p class=\"section-subtitle\">\n                    Six categories of everyday Foley sounds synthesized end-to-end by\n                    <span class=\"metablue strong\">WavFlow</span> — pure raw-waveform output, no VAE.\n                </p>\n            </div>\n\n            <!-- Tab buttons -->\n            <div class=\"tab-nav\">\n                <button class=\"tab-btn\" data-idx=\"0\">🌿 Natural</button>\n                <button class=\"tab-btn\" data-idx=\"1\">🐾 Animal</button>\n                <button class=\"tab-btn\" data-idx=\"2\">🎵 Music</button>\n                <button class=\"tab-btn\" data-idx=\"3\">🚲 Transportation</button>\n                <button class=\"tab-btn\" data-idx=\"4\">🏂 Sports</button>\n                <button class=\"tab-btn\" data-idx=\"5\">🔨 Daily Action</button>\n            </div>\n\n            <!-- Sliding viewport -->\n            <div class=\"slider-viewport\">\n                <button class=\"slider-arrow slider-prev\" aria-label=\"Previous\">&#10094;</button>\n                <button class=\"slider-arrow slider-next\" aria-label=\"Next\">&#10095;</button>\n\n                <div class=\"slider-track\">\n\n                    <!-- ===== Panel 0: Natural ===== -->\n                    <div class=\"slider-panel\">\n                        <div class=\"demo-grid\">\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Forest</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/0_natural_1_forest.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Rain</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/0_natural_2_rain.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Thunder</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/0_natural_3_thunder.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Fire</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/0_natural_4_volcano.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- ===== Panel 1: Animal ===== -->\n                    <div class=\"slider-panel\">\n                        <div class=\"demo-grid\">\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Frog</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/1_animal_1_frog.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Cat</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/1_animal_2_cat.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Duck</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/1_animal_2_duck.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Wolf</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/1_animal3_wolf.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- ===== Panel 2: Music ===== -->\n                    <div class=\"slider-panel\">\n                        <div class=\"demo-grid\">\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Dizi (Chinese Flute)</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/2_music_dizi.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Drum</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/2_music_drum.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Guitar</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/2_music_guitar.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Piano</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/2_music_paino.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- ===== Panel 3: Transport ===== -->\n                    <div class=\"slider-panel\">\n                        <div class=\"demo-grid\">\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Bicycle</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/3_transport_bycycle.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Jeep</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/3_transport_motor.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Ship</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/3_transport_ship.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Train</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/3_transport_train.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- ===== Panel 4: Sport ===== -->\n                    <div class=\"slider-panel\">\n                        <div class=\"demo-grid\">\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Skateboard</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/4_sport_skateboard.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Diving</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/4_sport_diving.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Skiing</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/4_sport_ski.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Swimming</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/4_sport_swim.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- ===== Panel 5: Action ===== -->\n                    <div class=\"slider-panel\">\n                        <div class=\"demo-grid\">\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Stirring Water</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/6_action.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Drilling</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/7_drilling.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Pouring Cereal</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/6_action2.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                            <div class=\"demo-card\">\n                                <div class=\"video-header\">Water Flow</div>\n                                <video controls preload=\"metadata\"><source src=\"videos/demo/6_action3.mp4\" type=\"video/mp4\"></video>\n                            </div>\n                        </div>\n                    </div>\n\n                </div><!-- /.slider-track -->\n            </div><!-- /.slider-viewport -->\n        </div>\n    </section>\n\n    <!-- ============== BENCHMARK: MovieGen ============== -->\n    <section id=\"benchmark\">\n        <div class=\"container\">\n            <div class=\"section-head\">\n                <span class=\"section-eyebrow\">MovieGen Benchmark</span>\n                <h2 class=\"section-title\">Comparison with Baselines</h2>\n                <p class=\"section-subtitle\">\n                    Click any scene to load the full side-by-side with\n                    <span class=\"metablue strong\">WavFlow (Ours)</span>, MMAudio,\n                    and MovieGen Audio.\n                </p>\n            </div>\n\n            <div class=\"benchmark-grid\" id=\"moviegen-grid\">\n                <!-- cards inserted by JS -->\n            </div>\n\n            <!-- Modal for case comparison -->\n            <dialog id=\"benchmark-modal\" class=\"benchmark-dialog\">\n                <form method=\"dialog\" class=\"modal-close-form\">\n                    <button class=\"modal-close\" aria-label=\"Close\" value=\"close\">&times;</button>\n                </form>\n                <div class=\"modal-eyebrow\">Side-by-side comparison</div>\n                <h2 id=\"modal-title\" class=\"modal-title\">Title</h2>\n                <div class=\"modal-divider\"></div>\n                <div class=\"modal-subhead\">Comparisons with Baselines</div>\n                <div class=\"compare-grid\">\n                    <div class=\"compare-cell is-ours\">\n                        <div class=\"video-header\">WavFlow (Ours)</div>\n                        <video id=\"modal-wavflow\" controls preload=\"metadata\" playsinline></video>\n                    </div>\n                    <div class=\"compare-cell\">\n                        <div class=\"video-header\">MMAudio</div>\n                        <video id=\"modal-mmaudio\" controls preload=\"metadata\" playsinline></video>\n                    </div>\n                    <div class=\"compare-cell\">\n                        <div class=\"video-header\">MovieGen Audio</div>\n                        <video id=\"modal-moviegen\" controls preload=\"metadata\" playsinline></video>\n                    </div>\n                </div>\n            </dialog>\n        </div>\n    </section>\n\n    <!-- ============== QUANTITATIVE RESULTS ============== -->\n    <section id=\"results\">\n        <div class=\"container\">\n            <div class=\"section-head\">\n                <span class=\"section-eyebrow\">Quantitative Results</span>\n                <h2 class=\"section-title\">State-of-the-Art Performance</h2>\n                <p class=\"section-subtitle\">\n                    Evaluated on <b>VGGSound-Test</b> and <b>MovieGen-Audio-Bench</b> against\n                    leading open-source and proprietary baselines.\n                </p>\n            </div>\n\n            <!-- VGGSound -->\n            <div class=\"results-card\">\n                <div class=\"results-card-head\">\n                    <h3 class=\"results-subtitle\">Evaluation on VGGSound-Test</h3>\n                    <span class=\"results-tag\">VT2A · Reference-based</span>\n                </div>\n                <p class=\"results-caption\">\n                    Comparison with state-of-the-art methods on VGGSound-Test for video-text-to-audio\n                    (VT2A) generation. Lower is better for FD, KL and DeSync; higher is better\n                    for IS, IB and CLAP.\n                </p>\n                <div class=\"legend\">\n                    <span class=\"legend-item\"><span class=\"legend-best\">best</span></span>\n                    <span class=\"legend-item\"><span class=\"legend-second\">second-best</span></span>\n                </div>\n\n                <div class=\"results-table-wrap\">\n                    <table class=\"results-table\">\n                        <thead>\n                            <tr>\n                                <th>Method</th>\n                                <th>FD<sub>PANNs</sub>&darr;</th>\n                                <th>FD<sub>PaSST</sub>&darr;</th>\n                                <th>KL<sub>PANNs</sub>&darr;</th>\n                                <th>IS<sub>PANNs</sub>&uarr;</th>\n                                <th>IB&uarr;</th>\n                                <th>DeSync&darr;</th>\n                                <th>CLAP&uarr;</th>\n                                <th>Params</th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            <tr>\n                                <td class=\"method\">Frieren<sup>&dagger;</sup></td>\n                                <td>11.45</td><td>106.10</td><td>2.73</td><td>12.25</td><td>0.23</td><td>0.85</td><td>0.11</td><td>159M</td>\n                            </tr>\n                            <tr>\n                                <td class=\"method\">V2A-Mapper<sup>&dagger;</sup></td>\n                                <td>8.40</td><td>84.57</td><td>2.69</td><td>12.47</td><td>0.23</td><td>1.23</td><td>0.11</td><td>229M</td>\n                            </tr>\n                            <tr>\n                                <td class=\"method\">HunyuanVideo-Foley<sup>&lowast;</sup></td>\n                                <td>10.53</td><td>97.85</td><td>2.02</td><td>14.99</td><td><u>0.32</u></td><td>0.54</td><td><b>0.23</b></td><td>&mdash;</td>\n                            </tr>\n                            <tr>\n                                <td class=\"method\">MMAudio-L-44.1kHz<sup>&dagger;</sup></td>\n                                <td><b>4.72</b></td><td>60.60</td><td><b>1.65</b></td><td><b>17.40</b></td><td><b>0.33</b></td><td><b>0.44</b></td><td><u>0.22</u></td><td>1.03B</td>\n                            </tr>\n                            <tr class=\"ours-row\">\n                                <td class=\"method\"><span class=\"metablue strong\">WavFlow-M-16kHz</span></td>\n                                <td>6.37</td><td>62.64</td><td>1.68</td><td><u>17.24</u></td><td>0.30</td><td>0.47</td><td>0.21</td><td>624M</td>\n                            </tr>\n                            <tr class=\"ours-row\">\n                                <td class=\"method\"><span class=\"metablue strong\">WavFlow-L-16kHz</span></td>\n                                <td>5.86</td><td><u>59.98</u></td><td><u>1.66</u></td><td><b>17.40</b></td><td>0.31</td><td><b>0.44</b></td><td><u>0.22</u></td><td>1.03B</td>\n                            </tr>\n                            <tr class=\"ours-row\">\n                                <td class=\"method\"><span class=\"metablue strong\">WavFlow-L-44.1kHz</span></td>\n                                <td><u>5.25</u></td><td><b>55.82</b></td><td>1.73</td><td>15.05</td><td>0.31</td><td><u>0.46</u></td><td>0.19</td><td>1.03B</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n\n                <p class=\"results-footnote\">\n                    All methods are evaluated on the same VGGSound test split from the\n                    MMAudio benchmark, utilizing original videos and native class labels as\n                    captions to ensure a fair comparison. Due to the difference in semantic\n                    granularity (sparse labels vs. dense captions), we exclude direct comparisons\n                    with models relying on LLM-refined captions.\n                    <sup>&dagger;</sup> results taken from the MMAudio paper.\n                    <sup>&lowast;</sup> reproduced using their open-source checkpoints on the same test set.\n                </p>\n            </div>\n\n            <!-- MovieGen-Audio-Bench -->\n            <div class=\"results-card\">\n                <div class=\"results-card-head\">\n                    <h3 class=\"results-subtitle\">Evaluation on MovieGen-Audio-Bench</h3>\n                    <span class=\"results-tag\">Reference-free</span>\n                </div>\n                <p class=\"results-caption\">\n                    Reference-free evaluation on MovieGen-Audio-Bench (no ground-truth audio).\n                </p>\n                <div class=\"legend\">\n                    <span class=\"legend-item\"><span class=\"legend-best\">best</span></span>\n                    <span class=\"legend-item\"><span class=\"legend-second\">second-best</span></span>\n                </div>\n\n                <div class=\"results-table-wrap\">\n                    <table class=\"results-table\">\n                        <thead>\n                            <tr>\n                                <th>Method</th>\n                                <th>Params</th>\n                                <th>Training Data</th>\n                                <th>IS&uarr;</th>\n                                <th>CLAP&uarr;</th>\n                                <th>IB-score&uarr;</th>\n                                <th>DeSync&darr;</th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            <tr class=\"ours-row\">\n                                <td class=\"method\"><span class=\"metablue strong\">WavFlow (Ours)</span></td>\n                                <td>1.03B</td>\n                                <td>~11.1K&nbsp;h</td>\n                                <td><b>8.95</b></td>\n                                <td><u>0.28</u></td>\n                                <td>0.24</td>\n                                <td><b>0.77</b></td>\n                            </tr>\n                            <tr>\n                                <td class=\"method\">MMAudio</td>\n                                <td>1.03B</td>\n                                <td>~8.2K&nbsp;h</td>\n                                <td>8.40</td>\n                                <td><u>0.28</u></td>\n                                <td><u>0.27</u></td>\n                                <td><b>0.77</b></td>\n                            </tr>\n                            <tr>\n                                <td class=\"method\">MovieGen</td>\n                                <td>13B</td>\n                                <td>~1,000K&nbsp;h</td>\n                                <td><u>8.89</u></td>\n                                <td><b>0.29</b></td>\n                                <td><b>0.36</b></td>\n                                <td><u>1.00</u></td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- ============== BIBTEX ============== -->\n    <section id=\"bibtex\">\n        <div class=\"container\">\n            <div class=\"section-head\">\n                <span class=\"section-eyebrow\">Citation</span>\n                <h2 class=\"section-title\">BibTeX</h2>\n            </div>\n\n            <div class=\"bibtex-card\">\n                <div class=\"bibtex-bar\">\n                    <span class=\"bibtex-dots\">\n                        <span></span><span></span><span></span>\n                    </span>\n                    <span style=\"margin-left:auto;margin-right:auto;letter-spacing:0.04em;\">wavflow.bib</span>\n                    <button class=\"bibtex-copy\" id=\"bibtex-copy-btn\" type=\"button\">Copy</button>\n                </div>\n<pre class=\"bibtex\" id=\"bibtex-content\">@misc{zhou2026wavflowaudiogenerationwaveform,\n      title={WavFlow: Audio Generation in Waveform Space}, \n      author={Feiyan Zhou and Luyuan Wang and Shoufa Chen and Zhe Wang and Zhiheng Liu and Yuren Cong and Xiaohui Zhang and Fanny Yang and Belinda Zeng},\n      year={2026},\n      eprint={2605.18749},\n      archivePrefix={arXiv},\n      primaryClass={cs.SD},\n      url={https://arxiv.org/abs/2605.18749}, \n}</pre>\n            </div>\n        </div>\n    </section>\n\n    <!-- ============== Footer ============== -->\n    <footer class=\"site-footer\">\n        <div class=\"container\">\n            Page template inspired by\n            <a href=\"https://prismaudio.github.io/\" target=\"_blank\" rel=\"noopener\">PrismAudio</a> and\n            <a href=\"https://hkchengrex.github.io/MMAudio/\" target=\"_blank\" rel=\"noopener\">MMAudio</a>.\n        </div>\n    </footer>\n\n    <!-- ============== Slider JS ============== -->\n    <script>\n    (function () {\n        const NUM_PANELS = 6;\n        let current = 0;\n\n        const track = document.querySelector(\".slider-track\");\n        const buttons = document.querySelectorAll(\".tab-btn\");\n        const panels = document.querySelectorAll(\".slider-panel\");\n\n        function pauseAllVideos() {\n            document.querySelectorAll(\".slider-track video\").forEach(v => {\n                if (!v.paused) v.pause();\n            });\n        }\n\n        function goTo(idx) {\n            current = (idx + NUM_PANELS) % NUM_PANELS;\n            track.style.transform = \"translateX(\" + (-current * 100) + \"%)\";\n            buttons.forEach((b, i) => b.classList.toggle(\"active\", i === current));\n            panels.forEach((p, i) => p.classList.toggle(\"active\", i === current));\n            pauseAllVideos();\n        }\n\n        buttons.forEach(btn => {\n            btn.addEventListener(\"click\", () => goTo(parseInt(btn.dataset.idx, 10)));\n        });\n\n        document.querySelector(\".slider-prev\").addEventListener(\"click\", () => goTo(current - 1));\n        document.querySelector(\".slider-next\").addEventListener(\"click\", () => goTo(current + 1));\n\n        document.addEventListener(\"keydown\", (e) => {\n            const tag = (document.activeElement && document.activeElement.tagName) || \"\";\n            if (tag === \"INPUT\" || tag === \"TEXTAREA\") return;\n            if (e.key === \"ArrowLeft\")  goTo(current - 1);\n            if (e.key === \"ArrowRight\") goTo(current + 1);\n        });\n\n        let touchStartX = 0;\n        track.addEventListener(\"touchstart\", e => { touchStartX = e.touches[0].clientX; }, { passive: true });\n        track.addEventListener(\"touchend\", e => {\n            const dx = e.changedTouches[0].clientX - touchStartX;\n            if (Math.abs(dx) > 50) goTo(current + (dx < 0 ? 1 : -1));\n        });\n\n        goTo(0);\n    })();\n    </script>\n\n    <!-- ============== Benchmark grid + modal JS ============== -->\n    <script>\n    (function () {\n        const cases = [\n            { id: 1,  label: \"Eating Apple\"        },\n            { id: 2,  label: \"Penguin Walking\"     },\n            { id: 3,  label: \"Boxing\"              },\n            { id: 4,  label: \"Horse Trotting\"      },\n            { id: 5,  label: \"Bear\"                },\n            { id: 6,  label: \"Firework\"            },\n            { id: 7,  label: \"Dog Drinking\"        },\n            { id: 8,  label: \"Car Approaching\"     },\n            { id: 9,  label: \"Rubbing Plastic Bag\" },\n            { id: 10, label: \"Cat Playing\"         },\n            { id: 11, label: \"People Laughing\"     },\n            { id: 12, label: \"Baby Grunting\"       },\n            { id: 13, label: \"Reading Newspaper\"   },\n            { id: 14, label: \"Playing Games\"       },\n            { id: 15, label: \"Clock\"               },\n        ];\n\n        function pad2(n) { return n < 10 ? \"0\" + n : \"\" + n; }\n        function casePath(idx, model) {\n            return \"videos/moviegen/case\" + pad2(idx) + \"_\" + model + \".mp4\";\n        }\n\n        const grid = document.getElementById(\"moviegen-grid\");\n        cases.forEach(c => {\n            const card = document.createElement(\"div\");\n            card.className = \"benchmark-card\";\n            card.dataset.case = c.id;\n            card.innerHTML = `\n                <div class=\"card-video-wrap\">\n                    <video class=\"card-video\" muted preload=\"metadata\" playsinline\n                           src=\"${casePath(c.id, \"wavflow\")}\"></video>\n                </div>\n                <div class=\"card-label\">${c.label}</div>\n            `;\n            grid.appendChild(card);\n\n            const vid = card.querySelector(\"video\");\n            card.addEventListener(\"mouseenter\", () => {\n                vid.currentTime = 0;\n                vid.play().catch(() => {});\n            });\n            card.addEventListener(\"mouseleave\", () => {\n                vid.pause();\n                vid.currentTime = 0;\n            });\n            card.addEventListener(\"click\", () => openModal(c));\n        });\n\n        const modal     = document.getElementById(\"benchmark-modal\");\n        const titleEl   = document.getElementById(\"modal-title\");\n        const players = {\n            wavflow:  document.getElementById(\"modal-wavflow\"),\n            mmaudio:  document.getElementById(\"modal-mmaudio\"),\n            moviegen: document.getElementById(\"modal-moviegen\"),\n        };\n\n        function openModal(c) {\n            titleEl.textContent = c.label;\n            for (const [m, v] of Object.entries(players)) {\n                v.pause();\n                v.src = casePath(c.id, m);\n                v.load();\n            }\n            if (typeof modal.showModal === \"function\") {\n                modal.showModal();\n            } else {\n                modal.setAttribute(\"open\", \"\");\n            }\n        }\n\n        modal.addEventListener(\"close\", () => {\n            for (const v of Object.values(players)) v.pause();\n        });\n    })();\n    </script>\n\n    <!-- ============== BibTeX copy JS ============== -->\n    <script>\n    (function () {\n        const btn = document.getElementById(\"bibtex-copy-btn\");\n        const pre = document.getElementById(\"bibtex-content\");\n        if (!btn || !pre) return;\n        btn.addEventListener(\"click\", async () => {\n            try {\n                await navigator.clipboard.writeText(pre.textContent.trim());\n                const old = btn.textContent;\n                btn.textContent = \"Copied ✓\";\n                setTimeout(() => { btn.textContent = old; }, 1500);\n            } catch (e) {\n                btn.textContent = \"Press Ctrl+C\";\n                setTimeout(() => { btn.textContent = \"Copy\"; }, 1500);\n            }\n        });\n    })();\n    </script>\n\n</body>\n</html>"
}